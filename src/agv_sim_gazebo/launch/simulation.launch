<launch>
    <!-- 1. 启动 Gazebo -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="use_sim_time" value="false"/>
    </include>

    <!-- 2. 生成模型 -->
    <param name="robot_description" command="$(find xacro)/xacro $(find agv_sim_gazebo)/urdf/agv.xacro" />
    <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" args="-param robot_description -urdf -model agv_robot -x 8 -y 0 -z 0.1 -Y 1.5708" />

    <!-- 3. TF 广播 -->
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

    <!-- 4. 🎯 仿真专用定位器 (使用底盘真实里程计替代 NDT) -->
    <node name="sim_localizer" pkg="agv_sim_gazebo" type="sim_localizer.py" output="screen" />

    <!-- 5. 启动你的原版导航控制 -->
    <include file="$(find robot_navigation)/launch/robot_Ctrl.launch" />

    <!-- 6. 桥梁 -->
    <node pkg="agv_sim_gazebo" type="nav_to_gazebo.py" name="nav_to_gazebo" output="screen" />

    <!-- 7. 假反馈信号 -->
    <node pkg="rostopic" type="rostopic" name="fake_battery" args="pub /Battery std_msgs/UInt8 '{data: 85}' -r 1" />
    <node pkg="rostopic" type="rostopic" name="fake_io" args="pub /DataIN std_msgs/UInt16 '{data: 4}' -r 10" /> 
</launch>
