<?xml version="1.0"?>
<robot name="agv_ackermann" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 几何参数 -->
  <xacro:property name="wheelbase" value="0.9"/>
  <xacro:property name="track" value="1.7"/>
  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="wheel_width" value="0.1"/>
  <xacro:property name="base_length" value="1.2"/>
  <xacro:property name="base_width" value="0.8"/>
  <xacro:property name="base_height" value="0.3"/>


  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>

  <!-- 车体 -->
  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- 车轮宏 -->
  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="black"/></visual>
      <collision><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
      <inertial><mass value="5.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
    </link>
    <gazebo reference="${name}">
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_link name="front_left_wheel"/>
  <xacro:wheel_link name="front_right_wheel"/>
  <xacro:wheel_link name="rear_left_wheel"/>
  <xacro:wheel_link name="rear_right_wheel"/>

  <!-- 前轮转向关节 -->
  <xacro:macro name="steering_joint" params="name parent child x y">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/><child link="${child}"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.6" upper="0.6" effort="100" velocity="1.0"/>
    </joint>
  </xacro:macro>

  <xacro:steering_joint name="front_left_steer_joint" parent="base_link" child="front_left_wheel" x="${wheelbase/2}" y="${track/2}"/>
  <xacro:steering_joint name="front_right_steer_joint" parent="base_link" child="front_right_wheel" x="${wheelbase/2}" y="-${track/2}"/>

  <!-- 后轮驱动关节 -->
  <xacro:macro name="drive_joint" params="name parent child x y">
    <joint name="${name}" type="continuous">
      <parent link="${parent}"/><child link="${child}"/>
      <origin xyz="${x} ${y} 0" rpy="1.5708 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="100" velocity="10.0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_joint name="rear_left_wheel_joint" parent="base_link" child="rear_left_wheel" x="-${wheelbase/2}" y="${track/2}"/>
  <xacro:drive_joint name="rear_right_wheel_joint" parent="base_link" child="rear_right_wheel" x="-${wheelbase/2}" y="-${track/2}"/>

  <!-- 雷达 -->
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.05" length="0.1"/></geometry><material name="yellow"/></visual>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <gazebo reference="lidar_link">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.5 0 0.5" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo 阿克曼插件 -->
  <gazebo>
    <plugin name="ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <wheel_separation>${track}</wheel_separation>
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_steer>0.6</max_steer>
      <front_left_joint>front_left_steer_joint</front_left_joint>
      <front_right_joint>front_right_steer_joint</front_right_joint>
      <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
      <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
  </gazebo>

  <!-- Gazebo 雷达插件 (输出到 /points_raw) -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar">
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=points_raw</remapping></ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal><samples>1800</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
          <vertical><samples>16</samples><min_angle>-0.261799</min_angle><max_angle>0.261799</max_angle></vertical>
        </scan>
        <range><min>0.5</min><max>50.0</max></range>
      </ray>
    </sensor>
  </gazebo>
</robot>
