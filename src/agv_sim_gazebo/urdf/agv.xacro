<?xml version="1.0"?>
<robot name="agv_sim" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 几何与物理参数定义 -->
  <xacro:property name="wheelbase" value="1.0"/>
  <xacro:property name="track" value="0.9"/>
  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="wheel_width" value="0.1"/>
  <xacro:property name="base_length" value="1.4"/>
  <xacro:property name="base_width" value="1.0"/>
  <xacro:property name="base_height" value="0.3"/>

  <!-- 材质 -->
  <material name="red"><color rgba="1.0 0.0 0.0 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="yellow"><color rgba="1.0 1.0 0.0 1.0"/></material>

  <!-- 虚拟根节点 -->
  <link name="base_footprint"/>

  <!-- 车体 -->
  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="3.0" ixy="0" ixz="0" iyy="6.0" iyz="0" izz="8.0"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + base_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- 车轮宏定义 -->
  <xacro:macro name="wheel_visual" params="name">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/> 
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </xacro:macro>

  <!-- 1. 左前轮 -->
  <link name="front_left_wheel"><xacro:wheel_visual name="front_left_wheel"/></link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_left_wheel"/>
    <origin xyz="${wheelbase/2} ${track/2} ${-base_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 2. 右前轮 -->
  <link name="front_right_wheel"><xacro:wheel_visual name="front_right_wheel"/></link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_right_wheel"/>
    <origin xyz="${wheelbase/2} ${-track/2} ${-base_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 3. 左后轮 (驱动轮) -->
  <link name="rear_left_wheel"><xacro:wheel_visual name="rear_left_wheel"/></link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_left_wheel"/>
    <origin xyz="${-wheelbase/2} ${track/2} ${-base_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 4. 右后轮 (驱动轮) -->
  <link name="rear_right_wheel"><xacro:wheel_visual name="rear_right_wheel"/></link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_right_wheel"/>
    <origin xyz="${-wheelbase/2} ${-track/2} ${-base_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 激光雷达 -->
    <!-- ==================== 双雷达模型 ==================== -->
  <!-- 左雷达 -->
  <link name="lidar_left">
    <visual><geometry><cylinder radius="0.05" length="0.1"/></geometry><material name="yellow"/></visual>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="lidar_left_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_left"/>
    <origin xyz="0.5 0 0.5" rpy="0 0 0"/>
  </joint>

  <!-- 右雷达 -->
  <link name="lidar_right">
    <visual><geometry><cylinder radius="0.05" length="0.1"/></geometry><material name="yellow"/></visual>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="lidar_right_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_right"/>
    <origin xyz="-0.5 0 0.5" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Gazebo 专属配置区 ==================== -->
  
  <gazebo reference="base_link"><material>Gazebo/Red</material></gazebo>
  <gazebo reference="lidar_link"><material>Gazebo/Yellow</material></gazebo>
  <gazebo reference="front_left_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="front_right_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rear_left_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rear_right_wheel"><material>Gazebo/Black</material></gazebo>

  <!-- 关键：前轮摩擦力设为0，模拟万向轮，允许转弯 -->
  <gazebo reference="front_left_wheel"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="front_right_wheel"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  
  <!-- 后轮增加抓地力 -->
  <gazebo reference="rear_left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="rear_right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

  <!-- 差速驱动插件 -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <updateRate>50.0</updateRate>
      <leftJoint>rear_left_wheel_joint</leftJoint>
      <rightJoint>rear_right_wheel_joint</rightJoint>
      <wheelSeparation>${track}</wheelSeparation>
      <wheelDiameter>${wheel_radius * 2}</wheelDiameter>
      <torque>20</torque>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <publishWheelTF>true</publishWheelTF>
      <publishOdomTF>true</publishOdomTF>
      <publishWheelJointState>true</publishWheelJointState>
      <legacyMode>false</legacyMode>
    </plugin>
  </gazebo>

  <!-- 激光雷达插件 -->
  <!-- 绝对稳妥的官方 2D 雷达插件 -->
    <!-- 左侧雷达插件，输出到 /scan_left -->
  <gazebo reference="lidar_left">
    <sensor type="ray" name="lidar_sensor_left">
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>360</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.3</min><max>30.0</max></range>
      </ray>
      <plugin name="gazebo_ros_laser_left" filename="libgazebo_ros_laser.so">
        <topicName>/scan_left</topicName>
        <frameName>lidar_left</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 右侧雷达插件，输出到 /scan_right -->
  <gazebo reference="lidar_right">
    <sensor type="ray" name="lidar_sensor_right">
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>360</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.3</min><max>30.0</max></range>
      </ray>
      <plugin name="gazebo_ros_laser_right" filename="libgazebo_ros_laser.so">
        <topicName>/scan_right</topicName>
        <frameName>lidar_right</frameName>
      </plugin>
    </sensor>
  </gazebo>
</robot>
