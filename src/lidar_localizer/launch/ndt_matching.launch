<!--    <include file="$(find robot_navigation)/launch/robot_Ctrl.launch" /> 
  <include file="$(find rslidar_sdk)/launch/start.launch" />
<include file="$(find rslidar_sdk)/launch/start.launch" />
  <include file="$(find map_file)/launch/points_map_loader.launch" />
  <include file="$(find points_downsampler)/launch/points_downsample.launch" />
<param name="output_tf_frame_id" value="$(arg output_tf_frame_id)" />
-->
<launch>

  <arg name="method_type" default="0" /> <!-- pcl_generic=0, pcl_anh=1, pcl_anh_gpu=2, pcl_openmp=3 -->
  <arg name="use_gnss" default="1" />
  <arg name="use_odom" default="false" />
  <arg name="use_imu" default="false" />
  <arg name="imu_upside_down" default="false" />
  <arg name="imu_topic" default="/imu_raw" />
  <arg name="queue_size" default="1" />
  <arg name="offset" default="linear" />
  <arg name="get_height" default="false" />
  <arg name="use_local_transform" default="false" />
  <arg name="sync" default="false" />
  <arg name="output_log_data" default="false" />
  <arg name="gnss_reinit_fitness" default="500.0" />
  <arg name="localizer" default="velodyne" /> 
  <arg name="tf_x" default="0.813" /> 
  <arg name="tf_y" default="0.020" />
  <arg name="tf_z" default="0.0" />
  <arg name="tf_roll" default="0.0" />
  <arg name="tf_pitch" default="0.0" />
  <arg name="tf_yaw" default="1.654" /> 
 

  <node pkg="lidar_localizer" type="ndt_matching" name="ndt_matching" output="screen" respawn="true" respawn_delay="5">
    <param name="method_type" value="$(arg method_type)" />
    <param name="use_gnss" value="$(arg use_gnss)" />
    <param name="use_odom" value="$(arg use_odom)" />
    <param name="use_imu" value="$(arg use_imu)" />
    <param name="imu_upside_down" value="$(arg imu_upside_down)" />
    <param name="imu_topic" value="$(arg imu_topic)" />
    <param name="queue_size" value="$(arg queue_size)" />
    <param name="offset" value="$(arg offset)" />
    <param name="get_height" value="$(arg get_height)" />
    <param name="use_local_transform" value="$(arg use_local_transform)" />
    <param name="output_log_data" value="$(arg output_log_data)" />
    
    <param name="gnss_reinit_fitness" value="$(arg gnss_reinit_fitness)" />
    <param name="localizer" type = "string" value="$(arg localizer)" />
    <param name="tf_x" type = "double" value="$(arg tf_x)" />
    <param name="tf_y" type = "double" value="$(arg tf_y)" />
    <param name="tf_z" type = "double" value="$(arg tf_z)" />
    <param name="tf_roll" type = "double" value="$(arg tf_roll)" />
    <param name="tf_pitch" type = "double" value="$(arg tf_pitch)" />
    <param name="tf_yaw" type = "double" value="$(arg tf_yaw)" />
    <remap from="/points_raw" to="/sync_drivers/points_raw" if="$(arg sync)" />
  </node>
  


</launch>
