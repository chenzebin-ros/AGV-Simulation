<launch>
  <arg name="method_type" default="0" /> 
  <arg name="use_gnss" default="0" />
  <arg name="use_odom" default="false" />
  <arg name="use_imu" default="false" />
  <arg name="tf_x" default="0.0" /> 
  <arg name="tf_y" default="0.0" />
  <arg name="tf_z" default="0.0" />
  <arg name="tf_roll" default="0.0" />
  <arg name="tf_pitch" default="0.0" />
  <arg name="tf_yaw" default="0.0" /> 

  <node pkg="lidar_localizer" type="ndt_matching" name="ndt_matching" output="screen" respawn="true" respawn_delay="5">
    <!-- 核心修复：把 localizer 放到节点内部，作为私有参数 -->
    <param name="localizer" value="velodyne" />
    
    <param name="method_type" value="$(arg method_type)" />
    <param name="use_gnss" value="$(arg use_gnss)" />
    <param name="use_odom" value="$(arg use_odom)" />
    <param name="use_imu" value="$(arg use_imu)" />
    <param name="tf_x" type="double" value="$(arg tf_x)" />
    <param name="tf_y" type="double" value="$(arg tf_y)" />
    <param name="tf_z" type="double" value="$(arg tf_z)" />
    <param name="tf_roll" type="double" value="$(arg tf_roll)" />
    <param name="tf_pitch" type="double" value="$(arg tf_pitch)" />
    <param name="tf_yaw" type="double" value="$(arg tf_yaw)" />
    
    <param name="min_scan_range" value="0.2" /> 
    <param name="max_scan_range" value="50.0" />
    <param name="max_iter" value="30" />
    <param name="trans_eps" value="0.01" />
    <param name="step_size" value="0.1" />
    <param name="ndt_res" value="1.0" />
    <param name="voxel_leaf_size" value="0.2" />

    <remap from="filtered_points" to="/points_raw" />
  </node>
</launch>
